<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="FluentPDF.Avalonia.Controls.TwoPageViewer">

    <Grid AutomationProperties.Name="TwoPageViewerRoot">
        <ScrollViewer x:Name="TwoPageScrollViewer"
                      AutomationProperties.Name="TwoPageScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                      HorizontalAlignment="Center">

            <Grid HorizontalAlignment="Center" Margin="20">
                <Grid.ColumnDefinitions>
                    <!-- Left page (even pages) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center spacing -->
                    <ColumnDefinition Width="24"/>
                    <!-- Right page (odd pages) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Page (Even) -->
                <Border Grid.Column="0"
                        x:Name="LeftPageBorder"
                        AutomationProperties.Name="LeftPageBorder"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        BoxShadow="0 2 8 0 #40000000"
                        IsVisible="False">
                    <Grid>
                        <Image x:Name="LeftPageImage"
                               AutomationProperties.Name="LeftPageImage"
                               Stretch="None"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <!-- Page number badge -->
                        <Border Background="{DynamicResource SystemAccentColor}"
                                CornerRadius="12"
                                Padding="12,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8">
                            <TextBlock x:Name="LeftPageNumber"
                                       AutomationProperties.Name="LeftPageNumber"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <!-- Loading indicator -->
                        <Panel x:Name="LeftPageLoader"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="False">
                            <ProgressBar IsIndeterminate="True"
                                         Width="100"/>
                        </Panel>
                    </Grid>
                </Border>

                <!-- Center Divider -->
                <Border Grid.Column="1"
                        Width="2"
                        Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        VerticalAlignment="Stretch"
                        Margin="0,20"/>

                <!-- Right Page (Odd) -->
                <Border Grid.Column="2"
                        x:Name="RightPageBorder"
                        AutomationProperties.Name="RightPageBorder"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        BoxShadow="0 2 8 0 #40000000">
                    <Grid>
                        <Image x:Name="RightPageImage"
                               AutomationProperties.Name="RightPageImage"
                               Stretch="None"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <!-- Page number badge -->
                        <Border Background="{DynamicResource SystemAccentColor}"
                                CornerRadius="12"
                                Padding="12,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8">
                            <TextBlock x:Name="RightPageNumber"
                                       AutomationProperties.Name="RightPageNumber"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <!-- Loading indicator -->
                        <Panel x:Name="RightPageLoader"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="False">
                            <ProgressBar IsIndeterminate="True"
                                         Width="100"/>
                        </Panel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Page navigation indicator -->
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                BoxShadow="0 2 8 0 #40000000">
            <TextBlock x:Name="PageRangeIndicator"
                       AutomationProperties.Name="PageRangeIndicator"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
