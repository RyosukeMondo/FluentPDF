<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FluentPDF.Core.ViewModels"
             xmlns:models="using:FluentPDF.Core.ViewModels"
             xmlns:converters="using:FluentPDF.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="180" d:DesignHeight="600"
             x:Class="FluentPDF.Avalonia.Controls.ThumbnailsSidebar">

    <UserControl.Resources>
        <converters:BoolToBorderBrushConverter x:Key="BoolToBorderBrushConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,0,1,0">

        <Grid RowDefinitions="Auto,*">

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="⟲"
                            Command="{Binding RotateLeftCommand}"
                            ToolTip.Tip="Rotate left"
                            Width="28"
                            Height="28"
                            IsEnabled="{Binding HasSelectedThumbnails}"/>
                    <Button Content="⟳"
                            Command="{Binding RotateRightCommand}"
                            ToolTip.Tip="Rotate right"
                            Width="28"
                            Height="28"
                            IsEnabled="{Binding HasSelectedThumbnails}"/>
                    <Separator Width="1" Height="20" Margin="4,0"/>
                    <Button Content="🗑"
                            Command="{Binding DeletePagesCommand}"
                            ToolTip.Tip="Delete pages"
                            Width="28"
                            Height="28"
                            IsEnabled="{Binding HasSelectedThumbnails}"/>
                </StackPanel>
            </Border>

            <!-- Thumbnails List -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ThumbnailsScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Thumbnails}"
                              AutomationProperties.Name="Page thumbnails">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" Margin="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ThumbnailItem">
                            <Button Command="{Binding $parent[UserControl].DataContext.NavigateToPageCommand}"
                                    CommandParameter="{Binding PageNumber}"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="2"
                                    BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBorderBrushConverter}}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding PageNumber, StringFormat='Page {0}'}">

                                <Grid RowDefinitions="*,Auto">
                                    <!-- Thumbnail Image -->
                                    <Border Grid.Row="0"
                                            Background="White"
                                            MinHeight="160"
                                            MaxHeight="200"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="4">
                                        <Panel>
                                            <!-- Loading Indicator -->
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="100"
                                                         IsVisible="{Binding IsLoading}"/>

                                            <!-- Thumbnail Image -->
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   MaxWidth="140"
                                                   MaxHeight="190"
                                                   IsVisible="{Binding !IsLoading}"/>
                                        </Panel>
                                    </Border>

                                    <!-- Page Number -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding PageNumber}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Margin="0,4,0,4"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
