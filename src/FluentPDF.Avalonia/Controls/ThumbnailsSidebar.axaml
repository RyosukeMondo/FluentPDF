<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FluentPDF.Core.ViewModels"
             xmlns:models="using:FluentPDF.Core.ViewModels"
             xmlns:converters="using:FluentPDF.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="180" d:DesignHeight="600"
             x:Class="FluentPDF.Avalonia.Controls.ThumbnailsSidebar">

    <UserControl.Resources>
        <converters:BoolToBorderBrushConverter x:Key="BoolToBorderBrushConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource AcrylicTintPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0">

        <Grid RowDefinitions="Auto,*">

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AcrylicTintPanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="4"
                            KeyboardNavigation.TabNavigation="Cycle">
                    <Button TabIndex="0"
                            Command="{Binding RotateLeftCommand}"
                            ToolTip.Tip="Rotate left"
                            AutomationProperties.Name="Rotate page left"
                            Classes="ToolbarIcon"
                            IsEnabled="{Binding HasSelectedThumbnails}">
                        <PathIcon Data="M7.11 8.53L5.7 7.11C4.8 8.27 4.24 9.61 4.07 11h2.02c.14-.87.49-1.72 1.02-2.47zM6.09 13H4.07c.17 1.39.72 2.73 1.62 3.89l1.41-1.42c-.52-.75-.87-1.59-1.01-2.47zM7.1 18.32l1.41-1.41A6.96 6.96 0 0 0 11 18.07v2.02A8.94 8.94 0 0 1 7.1 18.32zM13 4.07V1L8.45 5.55 13 10V6.09c2.84.48 5 2.94 5 5.91s-2.16 5.43-5 5.91v2.02c3.95-.49 7-3.85 7-7.93s-3.05-7.44-7-7.93z" Width="14" Height="14"/>
                    </Button>
                    <Button TabIndex="1"
                            Command="{Binding RotateRightCommand}"
                            ToolTip.Tip="Rotate right"
                            AutomationProperties.Name="Rotate page right"
                            Classes="ToolbarIcon"
                            IsEnabled="{Binding HasSelectedThumbnails}">
                        <PathIcon Data="M15.55 5.55L11 1v3.07C7.06 4.56 4 7.92 4 12s3.05 7.44 7 7.93v-2.02c-2.84-.48-5-2.94-5-5.91s2.16-5.43 5-5.91V10l4.55-4.45zM19.93 11c-.17-1.39-.72-2.73-1.62-3.89l-1.42 1.42c.54.75.88 1.6 1.02 2.47h2.02zM13 17.9v2.02c1.39-.17 2.74-.71 3.9-1.61l-1.42-1.42c-.74.54-1.59.89-2.48 1.01zM16.89 15.48l1.42 1.41c.9-1.16 1.45-2.5 1.62-3.89h-2.02c-.14.87-.48 1.72-1.02 2.48z" Width="14" Height="14"/>
                    </Button>
                    <Separator Width="1" Height="20" Margin="4,0" Background="{DynamicResource BorderSubtleBrush}"/>
                    <Button TabIndex="2"
                            Command="{Binding DeletePagesCommand}"
                            ToolTip.Tip="Delete pages"
                            AutomationProperties.Name="Delete selected pages"
                            Classes="ToolbarIcon"
                            IsEnabled="{Binding HasSelectedThumbnails}">
                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Thumbnails List -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ThumbnailsScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Thumbnails}"
                              AutomationProperties.Name="Page thumbnails">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" Margin="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ThumbnailItem">
                            <Button Command="{Binding $parent[UserControl].DataContext.NavigateToPageCommand}"
                                    CommandParameter="{Binding PageNumber}"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="2"
                                    BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBorderBrushConverter}}"
                                    CornerRadius="6"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    RenderTransformOrigin="0.5,0.5"
                                    AutomationProperties.Name="{Binding PageNumber, StringFormat='Page {0}'}">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="RenderTransform" Value="none" />
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.15" />
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="Background" Value="{DynamicResource PressOverlayBrush}"/>
                                        <Setter Property="RenderTransform" Value="scale(0.97)" />
                                    </Style>
                                </Button.Styles>

                                <Grid RowDefinitions="*,Auto">
                                    <!-- Thumbnail Image -->
                                    <Border Grid.Row="0"
                                            Background="White"
                                            MinHeight="160"
                                            MaxHeight="200"
                                            CornerRadius="4"
                                            BoxShadow="0 1 3 0 #20000000"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="4">
                                        <Panel>
                                            <!-- Loading Indicator -->
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="100"
                                                         IsVisible="{Binding IsLoading}"/>

                                            <!-- Thumbnail Image -->
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   MaxWidth="140"
                                                   MaxHeight="190"
                                                   IsVisible="{Binding !IsLoading}"/>
                                        </Panel>
                                    </Border>

                                    <!-- Page Number -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding PageNumber}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Margin="0,4,0,4"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
