<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FluentPDF.Core.ViewModels"
             xmlns:controls="using:FluentPDF.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="FluentPDF.Avalonia.Controls.SearchPanel"
             x:DataType="vm:SearchPanelViewModel"
             x:Name="SearchPanelRoot">

    <!-- SIMPLIFIED: Simple Border replaces complex GlassPanel -->
    <Border x:Name="SearchPanelContainer"
            Background="{DynamicResource AcrylicTintToolbarBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0,0,8,8"
            Padding="12,8"
            BoxShadow="0 2 6 0 #20000000">

        <!-- Slide-in/out animation transitions -->
        <Border.Transitions>
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                              Duration="0:0:0.25"
                                              Easing="CubicEaseOut"/>
                <DoubleTransition Property="Opacity"
                                 Duration="0:0:0.25"
                                 Easing="CubicEaseOut"/>
            </Transitions>
        </Border.Transitions>

        <StackPanel>
        <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto"
              KeyboardNavigation.TabNavigation="Cycle">

            <!-- Search Icon -->
            <PathIcon Grid.Column="0"
                      Data="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                      Width="16"
                      Height="16"
                      Margin="0,0,8,0"
                      Foreground="{DynamicResource ForegroundTertiaryBrush}"
                      VerticalAlignment="Center"/>

            <!-- Search TextBox -->
            <TextBox Grid.Column="1"
                     TabIndex="0"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="Search in document..."
                     MinWidth="200"
                     AutomationProperties.Name="Search input"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0"/>

            <!-- Match Counter -->
            <TextBlock Grid.Column="2"
                       Text="{Binding SearchResultsText}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       MinWidth="80"
                       TextAlignment="Center"
                       Foreground="{DynamicResource ForegroundTertiaryBrush}"/>

            <!-- Previous Match Button -->
            <Button Grid.Column="3"
                    TabIndex="1"
                    Command="{Binding PreviousMatchCommand}"
                    IsEnabled="{Binding HasMatches}"
                    ToolTip.Tip="Previous match (Shift+F3)"
                    Classes="ToolbarIcon"
                    Margin="0,0,4,0"
                    AutomationProperties.Name="Previous match">
                <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Width="14" Height="14"/>
            </Button>

            <!-- Next Match Button -->
            <Button Grid.Column="4"
                    TabIndex="2"
                    Command="{Binding NextMatchCommand}"
                    IsEnabled="{Binding HasMatches}"
                    ToolTip.Tip="Next match (F3)"
                    Classes="ToolbarIcon"
                    Margin="0,0,12,0"
                    AutomationProperties.Name="Next match">
                <PathIcon Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Width="14" Height="14"/>
            </Button>

            <!-- Options Panel -->
            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,12,0">

                <!-- Case Sensitive Toggle -->
                <ToggleButton TabIndex="3"
                              IsChecked="{Binding CaseSensitive, Mode=TwoWay}"
                              ToolTip.Tip="Match case"
                              Classes="ToolbarIcon"
                              Width="32"
                              Height="32"
                              AutomationProperties.Name="Match case">
                    <TextBlock Text="Aa"
                               FontWeight="Bold"
                               FontSize="12"/>
                </ToggleButton>

                <!-- Whole Word Toggle -->
                <ToggleButton TabIndex="4"
                              IsChecked="{Binding WholeWord, Mode=TwoWay}"
                              ToolTip.Tip="Match whole word"
                              Classes="ToolbarIcon"
                              Width="32"
                              Height="32"
                              AutomationProperties.Name="Match whole word">
                    <TextBlock Text="Ab|"
                               FontWeight="Bold"
                               FontSize="12"/>
                </ToggleButton>
            </StackPanel>

            <!-- Replace Section (conditionally visible) -->
            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        Spacing="4"
                        Margin="0,0,12,0">
                <TextBox TabIndex="5"
                         Text="{Binding ReplaceText, Mode=TwoWay}"
                         Watermark="Replace with..."
                         Width="150"
                         VerticalContentAlignment="Center"
                         IsVisible="{Binding HasMatches}"
                         AutomationProperties.Name="Replace text input"/>
                <Button TabIndex="6"
                        Content="Replace"
                        Classes="Secondary"
                        Command="{Binding ReplaceCommand}"
                        IsEnabled="{Binding HasMatches}"
                        IsVisible="{Binding HasMatches}"
                        ToolTip.Tip="Replace current match"
                        AutomationProperties.Name="Replace current match"/>
                <Button TabIndex="7"
                        Content="Replace All"
                        Classes="accent"
                        Command="{Binding ReplaceAllCommand}"
                        IsEnabled="{Binding HasMatches}"
                        IsVisible="{Binding HasMatches}"
                        ToolTip.Tip="Replace all matches"
                        AutomationProperties.Name="Replace all matches"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="7"
                    TabIndex="8"
                    Command="{Binding CloseSearchCommand}"
                    ToolTip.Tip="Close search (Esc)"
                    Classes="ToolbarIcon"
                    AutomationProperties.Name="Close search">
                <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12"/>
            </Button>
        </Grid>
        </Border>

        <!-- Search Results List -->
        <Border IsVisible="{Binding HasMatches}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,4,0,0">
            <StackPanel>
                <!-- Summary header -->
                <TextBlock Text="{Binding SearchResultsSummary}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           Margin="4,4,4,2"/>

                <!-- Scrollable results list -->
                <ScrollViewer MaxHeight="300"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchResultItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding $parent[UserControl].DataContext.NavigateToMatchCommand}"
                                        CommandParameter="{Binding MatchIndex}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,4"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        AutomationProperties.Name="{Binding PageNumber, StringFormat='Go to match on page {0}'}">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Transitions">
                                                <Transitions>
                                                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                                                </Transitions>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                        </Style>
                                        <Style Selector="Button:pressed">
                                            <Setter Property="Background" Value="{DynamicResource PressOverlayBrush}"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}:'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MatchText}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="400"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        </StackPanel>
    </Border>
</UserControl>
