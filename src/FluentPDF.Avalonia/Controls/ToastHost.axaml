<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FluentPDF.Core.ViewModels"
             x:Class="FluentPDF.Avalonia.Controls.ToastHost"
             x:DataType="vm:NotificationViewModel"
             IsHitTestVisible="True">

    <!-- Toast notification stack — anchored bottom-right -->
    <ItemsControl ItemsSource="{Binding Notifications}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,16,16"
                  MaxWidth="400">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ToastItem">
                <Border Margin="0,4"
                        Padding="12,8"
                        CornerRadius="6"
                        MinWidth="280"
                        BoxShadow="0 2 8 0 #40000000"
                        Background="{DynamicResource BackgroundSurfaceBrush}">
                    <Border.Styles>
                        <!-- Color-code the left border by toast type -->
                        <Style Selector="Border">
                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                        </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Icon -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Icon}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"/>

                        <!-- Message -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource ForegroundPrimaryBrush}"/>

                        <!-- Dismiss button -->
                        <Button Grid.Column="2"
                                Classes="Ghost"
                                Content="✕"
                                FontSize="12"
                                VerticalAlignment="Top"
                                Margin="8,0,0,0"
                                Command="{Binding $parent[ItemsControl].DataContext.DismissCommand}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Dismiss notification"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
