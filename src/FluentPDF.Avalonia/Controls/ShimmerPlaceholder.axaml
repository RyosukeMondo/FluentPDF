<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200"
             x:Class="FluentPDF.Avalonia.Controls.ShimmerPlaceholder">

    <!-- Shimmer container with clip for rounded corners -->
    <Border x:Name="OuterBorder" ClipToBounds="True"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <!-- Base placeholder background -->
            <Rectangle Fill="{DynamicResource LoadingSkeletonBrush}"
                       RadiusX="0" RadiusY="0"/>

            <!-- Shimmer gradient overlay — animated via Canvas.Left in code-behind -->
            <Canvas ClipToBounds="True">
                <Rectangle x:Name="ShimmerRectangle"
                           Width="200"
                           Height="{Binding $parent[Canvas].Bounds.Height}"
                           Canvas.Left="-200">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#20FFFFFF" Offset="0.4"/>
                            <GradientStop Color="#38FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#20FFFFFF" Offset="0.6"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
