<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FluentPDF.Core.ViewModels"
             xmlns:models="using:FluentPDF.Core.Models"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="600"
             x:Class="FluentPDF.Avalonia.Controls.BookmarksPanel"
             x:DataType="vm:BookmarksViewModel">

    <Border Background="{DynamicResource AcrylicTintPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1,0,0,0">

        <Grid RowDefinitions="Auto,*">

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AcrylicTintPanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <TextBlock Text="Bookmarks"
                           FontWeight="SemiBold"
                           FontSize="13"/>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">

                <!-- Loading Indicator -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            IsVisible="{Binding IsLoading}">
                    <ProgressBar IsIndeterminate="True" Width="150"/>
                    <TextBlock Text="Loading bookmarks..."
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundTertiaryBrush}"/>
                </StackPanel>

                <!-- Scrollable content with both sections -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding !IsLoading}">
                    <StackPanel Spacing="0">

                        <!-- User Bookmarks Section -->
                        <StackPanel x:Name="UserBookmarksSection"
                                    IsVisible="{Binding $parent[UserControl].DataContext.UserBookmarks.Count}">
                            <!-- Section Header -->
                            <Border Background="{DynamicResource AcrylicTintPanelBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"
                                              Width="12" Height="12"
                                              Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                    <TextBlock Text="Your Bookmarks"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- User Bookmark Items -->
                            <ItemsControl ItemsSource="{Binding $parent[UserControl].DataContext.UserBookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:UserBookmark">
                                        <Button Command="{Binding $parent[UserControl].DataContext.NavigateToUserBookmarkCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="12,6"
                                                CornerRadius="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                AutomationProperties.Name="{Binding PageNumber, StringFormat='Page {0}'}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <PathIcon Grid.Column="0"
                                                          Data="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"
                                                          Width="12" Height="12"
                                                          Foreground="#FFD700"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayLabel}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding PageNumber, StringFormat='p. {0}'}"
                                                           FontSize="11"
                                                           Opacity="0.6"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </Grid>
                                            <Button.Styles>
                                                <Style Selector="Button">
                                                    <Setter Property="Transitions">
                                                        <Transitions>
                                                            <BrushTransition Property="Background" Duration="0:0:0.15" />
                                                        </Transitions>
                                                    </Setter>
                                                </Style>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                                </Style>
                                                <Style Selector="Button:pressed">
                                                    <Setter Property="Background" Value="{DynamicResource PressOverlayBrush}"/>
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- PDF TOC Bookmarks Section -->
                        <StackPanel IsVisible="{Binding HasBookmarks}">
                            <!-- Section Header (only shown when user bookmarks also exist) -->
                            <Border Background="{DynamicResource AcrylicTintPanelBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,6"
                                    IsVisible="{Binding $parent[UserControl].DataContext.UserBookmarks.Count}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"
                                              Width="12" Height="12"
                                              Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                    <TextBlock Text="Table of Contents"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <TreeView ItemsSource="{Binding Bookmarks}"
                                      SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}"
                                      IsTabStop="True"
                                      KeyboardNavigation.TabNavigation="Continue"
                                      AutomationProperties.Name="Document bookmarks">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}" DataType="models:BookmarkNode">
                                        <Button Command="{Binding $parent[TreeView].DataContext.NavigateToBookmarkCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Title}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                CornerRadius="4"
                                                FontSize="13"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                ToolTip.Tip="{Binding PageNumber, StringFormat='Page {0}'}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Button.Styles>
                                                <Style Selector="Button">
                                                    <Setter Property="Transitions">
                                                        <Transitions>
                                                            <BrushTransition Property="Background" Duration="0:0:0.15" />
                                                        </Transitions>
                                                    </Setter>
                                                </Style>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                                </Style>
                                                <Style Selector="Button:pressed">
                                                    <Setter Property="Background" Value="{DynamicResource PressOverlayBrush}"/>
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>

                        <!-- Empty State (no PDF bookmarks AND no user bookmarks) -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    Margin="16,40"
                                    x:Name="EmptyState">
                            <PathIcon Data="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"
                                      Width="40"
                                      Height="40"
                                      Foreground="{DynamicResource ForegroundTertiaryBrush}"/>
                            <TextBlock Text="{Binding EmptyMessage}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="200"
                                       Foreground="{DynamicResource ForegroundTertiaryBrush}"/>
                            <TextBlock Text="Use the star button to bookmark pages"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="200"
                                       FontSize="11"
                                       Foreground="{DynamicResource ForegroundTertiaryBrush}"
                                       Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
