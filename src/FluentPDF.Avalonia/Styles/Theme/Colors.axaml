<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    FluentPDF Liquid Glass UI - Color Palette

    Defines comprehensive color schemes for Light, Dark, and HighContrast themes
    with WCAG AA compliance (4.5:1 for text, 3:1 for UI components).

    Task: 1.1 - Liquid Glass UI Enhancement
    Requirements: 1.1 (Color and Theming), 1.5 (Accessibility)
    -->

    <!-- ================================================================== -->
    <!-- LIGHT THEME COLORS                                                 -->
    <!-- ================================================================== -->

    <ResourceDictionary x:Key="Light">

        <!-- Background Colors -->
        <!-- Base canvas and container backgrounds -->
        <Color x:Key="ColorBackgroundBase">#F5F5F5</Color>                  <!-- Light gray base -->
        <Color x:Key="ColorBackgroundSurface">#FFFFFF</Color>               <!-- Pure white surface -->
        <Color x:Key="ColorBackgroundElevated">#FAFAFA</Color>              <!-- Elevated surface -->
        <Color x:Key="ColorBackgroundSubtle">#F0F0F0</Color>                <!-- Subtle background -->

        <!-- Foreground Colors -->
        <!-- Text and icon colors with WCAG AA compliance -->
        <Color x:Key="ColorForegroundPrimary">#1F1F1F</Color>               <!-- Primary text (17.5:1 on white) -->
        <Color x:Key="ColorForegroundSecondary">#616161</Color>             <!-- Secondary text (7.0:1 on white) -->
        <Color x:Key="ColorForegroundTertiary">#8E8E8E</Color>              <!-- Tertiary text (4.5:1 on white, minimum AA) -->
        <Color x:Key="ColorForegroundDisabled">#C7C7C7</Color>              <!-- Disabled text (2.8:1, non-interactive) -->
        <Color x:Key="ColorForegroundInverse">#FFFFFF</Color>               <!-- Text on dark backgrounds -->

        <!-- Accent Colors -->
        <!-- System accent detection fallback to blue -->
        <Color x:Key="ColorAccentPrimary">#0078D4</Color>                   <!-- Microsoft blue accent -->
        <Color x:Key="ColorAccentSecondary">#106EBE</Color>                 <!-- Darker accent for contrast -->
        <Color x:Key="ColorAccentTertiary">#E6F2FA</Color>                  <!-- Light accent tint -->
        <Color x:Key="ColorAccentHover">#005A9E</Color>                     <!-- Accent hover state -->
        <Color x:Key="ColorAccentPressed">#004578</Color>                   <!-- Accent pressed state -->

        <!-- Acrylic Tints -->
        <!-- Frosted glass effect colors with 60% opacity -->
        <Color x:Key="ColorAcrylicTintToolbar">#F3F3F3</Color>              <!-- Toolbar tint base -->
        <Color x:Key="ColorAcrylicTintPanel">#F8F8F8</Color>                <!-- Side panel tint -->
        <Color x:Key="ColorAcrylicTintDialog">#FCFCFC</Color>               <!-- Dialog tint -->
        <Color x:Key="ColorAcrylicTintTooltip">#F5F5F5</Color>              <!-- Tooltip tint -->

        <!-- Semantic Colors -->
        <!-- Success, warning, error, info states -->
        <Color x:Key="ColorSuccess">#107C10</Color>                         <!-- Green success (5.4:1 on white) -->
        <Color x:Key="ColorSuccessBackground">#DFF6DD</Color>               <!-- Light green background -->
        <Color x:Key="ColorWarning">#CA5010</Color>                         <!-- Orange warning (5.1:1 on white) -->
        <Color x:Key="ColorWarningBackground">#FFF4CE</Color>               <!-- Light yellow background -->
        <Color x:Key="ColorError">#D13438</Color>                           <!-- Red error (5.8:1 on white) -->
        <Color x:Key="ColorErrorBackground">#FDE7E9</Color>                 <!-- Light red background -->
        <Color x:Key="ColorInfo">#0078D4</Color>                            <!-- Blue info (5.1:1 on white) -->
        <Color x:Key="ColorInfoBackground">#E6F2FA</Color>                  <!-- Light blue background -->

        <!-- Border Colors -->
        <!-- UI component borders and dividers -->
        <Color x:Key="ColorBorderDefault">#E0E0E0</Color>                   <!-- Default border (1.3:1 on white) -->
        <Color x:Key="ColorBorderSubtle">#EDEDED</Color>                    <!-- Subtle divider (1.2:1) -->
        <Color x:Key="ColorBorderStrong">#C7C7C7</Color>                    <!-- Strong border (2.8:1) -->
        <Color x:Key="ColorBorderFocus">#0078D4</Color>                     <!-- Focus indicator (accent) -->

        <!-- UI State Colors -->
        <!-- Interactive element states -->
        <Color x:Key="ColorHoverOverlay">#0A000000</Color>                  <!-- 4% black hover -->
        <Color x:Key="ColorPressedOverlay">#14000000</Color>                <!-- 8% black pressed -->
        <Color x:Key="ColorSelectedBackground">#E6F2FA</Color>              <!-- Selected item background -->
        <Color x:Key="ColorSelectedBorder">#0078D4</Color>                  <!-- Selected item border -->

        <!-- Shadow and Elevation Colors -->
        <!-- Drop shadow colors for depth -->
        <Color x:Key="ColorShadowSmall">#1A000000</Color>                   <!-- 10% black small shadow -->
        <Color x:Key="ColorShadowMedium">#29000000</Color>                  <!-- 16% black medium shadow -->
        <Color x:Key="ColorShadowLarge">#3D000000</Color>                   <!-- 24% black large shadow -->

    </ResourceDictionary>

    <!-- ================================================================== -->
    <!-- DARK THEME COLORS                                                  -->
    <!-- ================================================================== -->

    <ResourceDictionary x:Key="Dark">

        <!-- Background Colors -->
        <!-- Base canvas and container backgrounds -->
        <Color x:Key="ColorBackgroundBase">#1F1F1F</Color>                  <!-- Dark gray base -->
        <Color x:Key="ColorBackgroundSurface">#2B2B2B</Color>               <!-- Elevated surface -->
        <Color x:Key="ColorBackgroundElevated">#353535</Color>              <!-- Higher elevation -->
        <Color x:Key="ColorBackgroundSubtle">#282828</Color>                <!-- Subtle background -->

        <!-- Foreground Colors -->
        <!-- Text and icon colors with WCAG AA compliance on dark backgrounds -->
        <Color x:Key="ColorForegroundPrimary">#FFFFFF</Color>               <!-- Primary text (17.5:1 on dark) -->
        <Color x:Key="ColorForegroundSecondary">#C7C7C7</Color>             <!-- Secondary text (8.5:1) -->
        <Color x:Key="ColorForegroundTertiary">#9E9E9E</Color>              <!-- Tertiary text (4.5:1 minimum AA) -->
        <Color x:Key="ColorForegroundDisabled">#5E5E5E</Color>              <!-- Disabled text (2.1:1, non-interactive) -->
        <Color x:Key="ColorForegroundInverse">#1F1F1F</Color>               <!-- Text on light backgrounds -->

        <!-- Accent Colors -->
        <!-- Brighter accent colors for dark theme -->
        <Color x:Key="ColorAccentPrimary">#60CDFF</Color>                   <!-- Light blue accent (dark theme) -->
        <Color x:Key="ColorAccentSecondary">#4CB8F5</Color>                 <!-- Slightly darker accent -->
        <Color x:Key="ColorAccentTertiary">#1A3A52</Color>                  <!-- Dark accent tint -->
        <Color x:Key="ColorAccentHover">#76D5FF</Color>                     <!-- Brighter hover -->
        <Color x:Key="ColorAccentPressed">#8CDCFF</Color>                   <!-- Brightest pressed -->

        <!-- Acrylic Tints -->
        <!-- Frosted glass effect colors with 60% opacity for dark theme -->
        <Color x:Key="ColorAcrylicTintToolbar">#2B2B2B</Color>              <!-- Dark toolbar tint -->
        <Color x:Key="ColorAcrylicTintPanel">#252525</Color>                <!-- Dark panel tint -->
        <Color x:Key="ColorAcrylicTintDialog">#2F2F2F</Color>               <!-- Dark dialog tint -->
        <Color x:Key="ColorAcrylicTintTooltip">#333333</Color>              <!-- Dark tooltip tint -->

        <!-- Semantic Colors -->
        <!-- Success, warning, error, info states for dark theme -->
        <Color x:Key="ColorSuccess">#6CCB5F</Color>                         <!-- Bright green (7.2:1 on dark) -->
        <Color x:Key="ColorSuccessBackground">#1F3B1E</Color>               <!-- Dark green background -->
        <Color x:Key="ColorWarning">#FCE100</Color>                         <!-- Bright yellow (12.1:1 on dark) -->
        <Color x:Key="ColorWarningBackground">#3D3420</Color>               <!-- Dark yellow background -->
        <Color x:Key="ColorError">#F1707B</Color>                           <!-- Light red (6.1:1 on dark) -->
        <Color x:Key="ColorErrorBackground">#3D2426</Color>                 <!-- Dark red background -->
        <Color x:Key="ColorInfo">#60CDFF</Color>                            <!-- Bright blue (9.5:1 on dark) -->
        <Color x:Key="ColorInfoBackground">#1F3042</Color>                  <!-- Dark blue background -->

        <!-- Border Colors -->
        <!-- UI component borders and dividers for dark theme -->
        <Color x:Key="ColorBorderDefault">#454545</Color>                   <!-- Default border (1.4:1) -->
        <Color x:Key="ColorBorderSubtle">#383838</Color>                    <!-- Subtle divider (1.2:1) -->
        <Color x:Key="ColorBorderStrong">#5E5E5E</Color>                    <!-- Strong border (1.8:1) -->
        <Color x:Key="ColorBorderFocus">#60CDFF</Color>                     <!-- Focus indicator (bright accent) -->

        <!-- UI State Colors -->
        <!-- Interactive element states for dark theme -->
        <Color x:Key="ColorHoverOverlay">#0AFFFFFF</Color>                  <!-- 4% white hover -->
        <Color x:Key="ColorPressedOverlay">#14FFFFFF</Color>                <!-- 8% white pressed -->
        <Color x:Key="ColorSelectedBackground">#1F3042</Color>              <!-- Selected item background -->
        <Color x:Key="ColorSelectedBorder">#60CDFF</Color>                  <!-- Selected item border -->

        <!-- Shadow and Elevation Colors -->
        <!-- Drop shadow colors for depth (stronger in dark theme) -->
        <Color x:Key="ColorShadowSmall">#33000000</Color>                   <!-- 20% black small shadow -->
        <Color x:Key="ColorShadowMedium">#4D000000</Color>                  <!-- 30% black medium shadow -->
        <Color x:Key="ColorShadowLarge">#66000000</Color>                   <!-- 40% black large shadow -->

    </ResourceDictionary>

    <!-- ================================================================== -->
    <!-- HIGH CONTRAST THEME COLORS                                         -->
    <!-- ================================================================== -->

    <ResourceDictionary x:Key="HighContrast">

        <!-- Background Colors -->
        <!-- Maximum contrast backgrounds (pure black/white) -->
        <Color x:Key="ColorBackgroundBase">#000000</Color>                  <!-- Pure black -->
        <Color x:Key="ColorBackgroundSurface">#000000</Color>               <!-- Pure black surface -->
        <Color x:Key="ColorBackgroundElevated">#000000</Color>              <!-- No elevation distinction -->
        <Color x:Key="ColorBackgroundSubtle">#000000</Color>                <!-- Pure black -->

        <!-- Foreground Colors -->
        <!-- Maximum contrast text (pure white on black) -->
        <Color x:Key="ColorForegroundPrimary">#FFFFFF</Color>               <!-- Pure white (21:1) -->
        <Color x:Key="ColorForegroundSecondary">#FFFFFF</Color>             <!-- Pure white (21:1) -->
        <Color x:Key="ColorForegroundTertiary">#FFFFFF</Color>              <!-- Pure white (21:1) -->
        <Color x:Key="ColorForegroundDisabled">#7F7F7F</Color>              <!-- 50% gray for disabled -->
        <Color x:Key="ColorForegroundInverse">#000000</Color>               <!-- Pure black on white -->

        <!-- Accent Colors -->
        <!-- High contrast accent (pure cyan) -->
        <Color x:Key="ColorAccentPrimary">#00FFFF</Color>                   <!-- Pure cyan accent -->
        <Color x:Key="ColorAccentSecondary">#00FFFF</Color>                 <!-- Pure cyan -->
        <Color x:Key="ColorAccentTertiary">#00FFFF</Color>                  <!-- Pure cyan -->
        <Color x:Key="ColorAccentHover">#00FFFF</Color>                     <!-- Pure cyan (no change) -->
        <Color x:Key="ColorAccentPressed">#00CCCC</Color>                   <!-- Slightly darker cyan -->

        <!-- Acrylic Tints -->
        <!-- No acrylic in high contrast - use solid colors -->
        <Color x:Key="ColorAcrylicTintToolbar">#000000</Color>              <!-- Solid black -->
        <Color x:Key="ColorAcrylicTintPanel">#000000</Color>                <!-- Solid black -->
        <Color x:Key="ColorAcrylicTintDialog">#000000</Color>               <!-- Solid black -->
        <Color x:Key="ColorAcrylicTintTooltip">#000000</Color>              <!-- Solid black -->

        <!-- Semantic Colors -->
        <!-- High contrast semantic colors (pure hues) -->
        <Color x:Key="ColorSuccess">#00FF00</Color>                         <!-- Pure green -->
        <Color x:Key="ColorSuccessBackground">#000000</Color>               <!-- Black background -->
        <Color x:Key="ColorWarning">#FFFF00</Color>                         <!-- Pure yellow -->
        <Color x:Key="ColorWarningBackground">#000000</Color>               <!-- Black background -->
        <Color x:Key="ColorError">#FF0000</Color>                           <!-- Pure red -->
        <Color x:Key="ColorErrorBackground">#000000</Color>                 <!-- Black background -->
        <Color x:Key="ColorInfo">#00FFFF</Color>                            <!-- Pure cyan -->
        <Color x:Key="ColorInfoBackground">#000000</Color>                  <!-- Black background -->

        <!-- Border Colors -->
        <!-- High contrast borders (pure white) -->
        <Color x:Key="ColorBorderDefault">#FFFFFF</Color>                   <!-- Pure white border -->
        <Color x:Key="ColorBorderSubtle">#FFFFFF</Color>                    <!-- Pure white border -->
        <Color x:Key="ColorBorderStrong">#FFFFFF</Color>                    <!-- Pure white border -->
        <Color x:Key="ColorBorderFocus">#00FFFF</Color>                     <!-- Cyan focus indicator -->

        <!-- UI State Colors -->
        <!-- High contrast states -->
        <Color x:Key="ColorHoverOverlay">#00000000</Color>                  <!-- No overlay (transparent) -->
        <Color x:Key="ColorPressedOverlay">#00000000</Color>                <!-- No overlay (transparent) -->
        <Color x:Key="ColorSelectedBackground">#00FFFF</Color>              <!-- Cyan selection -->
        <Color x:Key="ColorSelectedBorder">#FFFFFF</Color>                  <!-- White border -->

        <!-- Shadow and Elevation Colors -->
        <!-- No shadows in high contrast mode -->
        <Color x:Key="ColorShadowSmall">#00000000</Color>                   <!-- Transparent (no shadow) -->
        <Color x:Key="ColorShadowMedium">#00000000</Color>                  <!-- Transparent (no shadow) -->
        <Color x:Key="ColorShadowLarge">#00000000</Color>                   <!-- Transparent (no shadow) -->

    </ResourceDictionary>

    <!-- ================================================================== -->
    <!-- THEME-AWARE BRUSH RESOURCES                                        -->
    <!-- ================================================================== -->

    <!-- These brushes automatically switch based on active theme -->

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BackgroundBaseBrush" Color="{DynamicResource ColorBackgroundBase}" />
    <SolidColorBrush x:Key="BackgroundSurfaceBrush" Color="{DynamicResource ColorBackgroundSurface}" />
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{DynamicResource ColorBackgroundElevated}" />
    <SolidColorBrush x:Key="BackgroundSubtleBrush" Color="{DynamicResource ColorBackgroundSubtle}" />

    <!-- Foreground Brushes -->
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="{DynamicResource ColorForegroundPrimary}" />
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{DynamicResource ColorForegroundSecondary}" />
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="{DynamicResource ColorForegroundTertiary}" />
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="{DynamicResource ColorForegroundDisabled}" />
    <SolidColorBrush x:Key="ForegroundInverseBrush" Color="{DynamicResource ColorForegroundInverse}" />

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{DynamicResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{DynamicResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="AccentTertiaryBrush" Color="{DynamicResource ColorAccentTertiary}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource ColorAccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource ColorAccentPressed}" />

    <!-- Acrylic Tint Brushes (60% opacity) -->
    <SolidColorBrush x:Key="AcrylicTintToolbarBrush" Color="{DynamicResource ColorAcrylicTintToolbar}" Opacity="0.6" />
    <SolidColorBrush x:Key="AcrylicTintPanelBrush" Color="{DynamicResource ColorAcrylicTintPanel}" Opacity="0.6" />
    <SolidColorBrush x:Key="AcrylicTintDialogBrush" Color="{DynamicResource ColorAcrylicTintDialog}" Opacity="0.6" />
    <SolidColorBrush x:Key="AcrylicTintTooltipBrush" Color="{DynamicResource ColorAcrylicTintTooltip}" Opacity="0.6" />

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource ColorSuccess}" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{DynamicResource ColorSuccessBackground}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource ColorWarning}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{DynamicResource ColorWarningBackground}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ColorError}" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{DynamicResource ColorErrorBackground}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource ColorInfo}" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{DynamicResource ColorInfoBackground}" />

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{DynamicResource ColorBorderDefault}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{DynamicResource ColorBorderFocus}" />

    <!-- UI State Brushes -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{DynamicResource ColorHoverOverlay}" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="{DynamicResource ColorPressedOverlay}" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{DynamicResource ColorSelectedBackground}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{DynamicResource ColorSelectedBorder}" />

    <!-- Shadow Brushes -->
    <SolidColorBrush x:Key="ShadowSmallBrush" Color="{DynamicResource ColorShadowSmall}" />
    <SolidColorBrush x:Key="ShadowMediumBrush" Color="{DynamicResource ColorShadowMedium}" />
    <SolidColorBrush x:Key="ShadowLargeBrush" Color="{DynamicResource ColorShadowLarge}" />

</ResourceDictionary>
