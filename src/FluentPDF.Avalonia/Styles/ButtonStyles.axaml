<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Button.ToolbarIcon - Compact 32x32 icon-only button with liquid glass hover -->
    <Style Selector="Button.ToolbarIcon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>
    <Style Selector="Button.ToolbarIcon:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
    </Style>
    <Style Selector="Button.ToolbarIcon:pressed">
        <Setter Property="Background" Value="{DynamicResource PressOverlayBrush}" />
        <Setter Property="RenderTransform">
            <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
        </Setter>
    </Style>
    <Style Selector="Button.ToolbarIcon:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Focus indicator: 2px accent border for keyboard navigation (WCAG 2.4.7) -->
    <Style Selector="Button.ToolbarIcon:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ToggleButton.ToolbarIcon - Same as Button.ToolbarIcon with checked state -->
    <Style Selector="ToggleButton.ToolbarIcon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>
    <Style Selector="ToggleButton.ToolbarIcon:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.ToolbarIcon:pressed">
        <Setter Property="Background" Value="{DynamicResource PressOverlayBrush}" />
        <Setter Property="RenderTransform">
            <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
        </Setter>
    </Style>
    <Style Selector="ToggleButton.ToolbarIcon:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Focus indicator for keyboard navigation -->
    <Style Selector="ToggleButton.ToolbarIcon:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleButton.ToolbarIcon:checked">
        <Setter Property="Background" Value="{DynamicResource AccentTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <!-- Button.accent - Primary action button with accent color -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundInverseBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.accent:focus-visible">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForegroundPrimaryBrush}" />
    </Style>

    <!-- Button.Ghost - Minimal transparent button -->
    <Style Selector="Button.Ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.Ghost:pointerover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
    </Style>
    <Style Selector="Button.Ghost:focus-visible">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Global focus-visible style for all Buttons and ToggleButtons not covered above -->
    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>
    <Style Selector="ToggleButton:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
    </Style>

    <!-- Tab styling for compact, modern look -->
    <Style Selector="TabControl#MainTabControl TabItem">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="TabControl#MainTabControl TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
    </Style>
    <Style Selector="TabControl#MainTabControl TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
    </Style>

    <!-- Compact toolbar TextBox -->
    <Style Selector="TextBox.ToolbarInput">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundSurfaceBrush}"/>
    </Style>
    <Style Selector="TextBox.ToolbarInput:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
    </Style>

    <!-- Compact toolbar ComboBox -->
    <Style Selector="ComboBox.ToolbarInput">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundSurfaceBrush}"/>
    </Style>

</Styles>
