<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FluentPDF.Avalonia.Dialogs.WelcomeDialog"
        Title="Welcome to FluentPDF"
        Width="500" MinHeight="400" MaxHeight="700"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource BackgroundSurfaceBrush}"
        CornerRadius="8">

    <Window.Styles>
        <StyleInclude Source="avares://FluentPDF.Avalonia/Dialogs/DialogStyles.axaml" />
    </Window.Styles>

    <StackPanel Margin="32" Spacing="12">
        <!-- Title -->
        <TextBlock Text="Welcome to FluentPDF"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundPrimaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4" />

        <TextBlock Text="AI-powered PDF viewer for regulatory documents"
                   FontSize="14"
                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16" />

        <!-- Feature: Search -->
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
            <Viewbox Width="28" Height="28">
                <PathIcon Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                         Foreground="{DynamicResource AccentPrimaryBrush}" />
            </Viewbox>
            <StackPanel Spacing="2">
                <TextBlock Text="Smart Search" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                <TextBlock Text="Find text across hundreds of pages instantly with highlighted results."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Feature: AI -->
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
            <Viewbox Width="28" Height="28">
                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                         Foreground="{DynamicResource AccentPrimaryBrush}" />
            </Viewbox>
            <StackPanel Spacing="2">
                <TextBlock Text="AI-Powered Tools" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                <TextBlock Text="Use Claude to search, summarize, and navigate your documents."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Feature: Edit -->
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
            <Viewbox Width="28" Height="28">
                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                         Foreground="{DynamicResource AccentPrimaryBrush}" />
            </Viewbox>
            <StackPanel Spacing="2">
                <TextBlock Text="Edit &amp; Annotate" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                <TextBlock Text="Draw shapes, add text, insert stamps, and highlight content."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,16,0,0">
            <Button Content="Get Started" Width="120"                     Click="OnGetStartedClick" />
            <Button Content="Open a PDF" Width="120" Classes="accent"
                    Click="OnOpenPdfClick" />
        </StackPanel>
    </StackPanel>
</Window>
