<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FluentPDF.Avalonia.Dialogs.TextInputDialog"
        Title="Input"
        Width="400" MinHeight="200" MaxHeight="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource BackgroundSurfaceBrush}"
        CornerRadius="8">

    <Window.Styles>
        <StyleInclude Source="avares://FluentPDF.Avalonia/Dialogs/DialogStyles.axaml" />
    </Window.Styles>

    <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="PromptText"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundPrimaryBrush}" />

        <TextBox x:Name="InputBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Width="100"
                    Click="OnCancelClick" />
            <Button Content="OK" Width="100" Classes="accent"
                    Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
