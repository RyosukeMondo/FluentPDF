<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FluentPDF.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="400"
             x:Class="FluentPDF.Avalonia.Views.DiagnosticsPanel"
             x:DataType="vm:DiagnosticsPanelViewModel"
             IsVisible="{Binding IsVisible}">

    <!-- SIMPLIFIED: Removed GlassPanel complexity, using simple Border -->
    <Border Background="#D0202020"
            IsHitTestVisible="True"
            CornerRadius="8"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="24"
            Width="320"
            MaxHeight="600"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 4 16 0 #40000000">

        <StackPanel Spacing="12">

            <!-- Header with Close Button -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                          Text="Performance Diagnostics"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Foreground="White" />

                <Button Grid.Column="1"
                       x:Name="CloseButton"
                       Content="✕"
                       Classes="Ghost"
                       Padding="8,4"
                       Foreground="White"
                       FontSize="16"
                       IsHitTestVisible="True"
                       Focusable="True"
                       ToolTip.Tip="Close diagnostics panel"
                       AutomationProperties.AutomationId="DiagnosticsCloseButton" />
            </Grid>

            <Separator Background="{DynamicResource GlassBorderBrush}" Margin="0,0,0,12" />

            <!-- FPS Display -->
            <StackPanel Spacing="4">
                <TextBlock Text="Frames Per Second"
                          FontSize="12"
                          Foreground="#AAAAAA" />
                <TextBlock Text="{Binding CurrentFPS, StringFormat='{}{0:F1} FPS'}"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="{Binding FpsColor}" />
            </StackPanel>

            <Separator Background="{DynamicResource GlassBorderBrush}" Margin="0,8" />

            <!-- Memory Usage -->
            <StackPanel Spacing="4">
                <TextBlock Text="Memory Usage"
                          FontSize="12"
                          Foreground="#AAAAAA" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                              Text="Total"
                              FontSize="14"
                              Foreground="White" />
                    <TextBlock Grid.Column="1"
                              Text="{Binding TotalMemoryMB, StringFormat='{}{0} MB'}"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="White" />
                </Grid>
            </StackPanel>

            <Separator Background="{DynamicResource GlassBorderBrush}" Margin="0,8" />

            <!-- Frame Timing -->
            <StackPanel Spacing="4">
                <TextBlock Text="Frame Timing"
                          FontSize="12"
                          Foreground="#AAAAAA" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                              Text="Last Render"
                              FontSize="14"
                              Foreground="White" />
                    <TextBlock Grid.Column="1"
                              Text="{Binding LastRenderTimeMs, StringFormat='{}{0:F2} ms'}"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="White" />
                </Grid>
            </StackPanel>

            <Separator Background="{DynamicResource GlassBorderBrush}" Margin="0,8" />

            <!-- Actions -->
            <Button Content="Export Metrics"
                   Command="{Binding ExportMetricsCommand}"
                   HorizontalAlignment="Stretch"
                   Classes="accent"
                   Padding="16,6" />

        </StackPanel>
    </Border>

</UserControl>
