<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FluentPDF.Core.ViewModels"
             xmlns:controls="using:FluentPDF.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="FluentPDF.Avalonia.Views.PdfViewerPage"
             x:DataType="vm:PdfViewerViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Search Panel -->
            <RowDefinition Height="Auto"/>
            <!-- Content with sidebars -->
            <RowDefinition Height="*"/>
            <!-- Selection Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Panel -->
        <controls:SearchPanel Grid.Row="0"
                              DataContext="{Binding Search}"
                              IsVisible="{Binding IsSearchPanelVisible}"/>

        <!-- Main Content Area with Sidebars -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">

            <!-- Thumbnails Sidebar -->
            <controls:ThumbnailsSidebar Grid.Column="0"
                                        DataContext="{Binding Thumbnails}"
                                        IsVisible="{Binding $parent[UserControl].DataContext.IsSidebarVisible}"
                                        Width="180"/>

            <!-- PDF Content Area -->
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="PdfScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource BackgroundBaseBrush}">

                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Margin="16"
                            Background="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">

                        <!-- PDF Page with Selection Overlay -->
                        <Grid>
                            <!-- PDF Page Image -->
                            <Image Source="{Binding CurrentPageImage}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   x:Name="PdfImage"/>

                            <!-- Selection Rectangle Overlay -->
                            <Canvas x:Name="SelectionCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False">
                                <Rectangle x:Name="SelectionRectangle"
                                           Fill="#4000BFFF"
                                           Stroke="#FF00BFFF"
                                           StrokeThickness="1"
                                           IsVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- Loading Overlay -->
                <Border Background="{DynamicResource DialogOverlayBrush}"
                        IsVisible="{Binding IsLoading}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <ProgressBar IsIndeterminate="True"
                                     Width="200"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource ForegroundInverseBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Error Display - hidden, errors shown via dialog service -->
                <Border Background="{DynamicResource BackgroundBaseBrush}"
                        IsVisible="False">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16"
                                MaxWidth="400">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Width="48"
                                  Height="48"
                                  Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                        <TextBlock Text="An error occurred"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <Button Content="Try Again"
                                Command="{Binding OpenDocumentCommand}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bookmarks Sidebar -->
            <controls:BookmarksPanel Grid.Column="2"
                                     DataContext="{Binding Bookmarks}"
                                     IsVisible="{Binding $parent[UserControl].DataContext.IsBookmarksPanelVisible}"
                                     Width="250"/>
        </Grid>
        <!-- Selection Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource AcrylicTintToolbarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                IsVisible="{Binding HasSelectedText}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedText}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="Ctrl+C to copy"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundTertiaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
