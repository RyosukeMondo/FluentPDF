<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FluentPDF.Core.ViewModels"
             xmlns:controls="using:FluentPDF.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="FluentPDF.Avalonia.Views.PdfViewerPage"
             x:DataType="vm:PdfViewerViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Search Panel -->
            <RowDefinition Height="Auto"/>
            <!-- Drawing Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Content with sidebars -->
            <RowDefinition Height="*"/>
            <!-- Page Summary Strip -->
            <RowDefinition Height="Auto"/>
            <!-- Selection Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Panel -->
        <controls:SearchPanel Grid.Row="0"
                              DataContext="{Binding Search}"
                              IsVisible="{Binding $parent[UserControl].DataContext.IsSearchPanelVisible}"/>

        <!-- Drawing Toolbar (PowerPoint-like, stays open until closed) -->
        <Border Grid.Row="1"
                Background="{DynamicResource AcrylicTintToolbarBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4"
                IsVisible="{Binding IsDrawingToolbarVisible}">
            <StackPanel Orientation="Horizontal" Spacing="4"
                        KeyboardNavigation.TabNavigation="Cycle">

                <!-- Primary Tool Selection -->
                <ToggleButton x:Name="DrawToolSelect"
                              TabIndex="0"
                              ToolTip.Tip="Select / Move (marquee drag on empty, Shift=add, Alt=subtract)"
                              AutomationProperties.Name="Select or move"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M3 2l7.5 18 2.2-7.3L20 10.5z" Width="14" Height="14"/>
                </ToggleButton>
                <ToggleButton x:Name="DrawToolRectangle"
                              TabIndex="1"
                              ToolTip.Tip="Rectangle"
                              AutomationProperties.Name="Draw rectangle"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M3 3h18v18H3V3zm2 2v14h14V5H5z" Width="14" Height="14"/>
                </ToggleButton>
                <ToggleButton x:Name="DrawToolLine"
                              TabIndex="2"
                              ToolTip.Tip="Line"
                              AutomationProperties.Name="Draw line"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M3.29 20.71a1 1 0 0 0 1.42 0l16-16a1 1 0 1 0-1.42-1.42l-16 16a1 1 0 0 0 0 1.42z" Width="14" Height="14"/>
                </ToggleButton>
                <ToggleButton x:Name="DrawToolText"
                              TabIndex="3"
                              ToolTip.Tip="Text"
                              AutomationProperties.Name="Add text"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M5 4v3h5.5v12h3V7H19V4H5z" Width="14" Height="14"/>
                </ToggleButton>

                <!-- More drawing tools overflow -->
                <Button x:Name="DrawToolMoreButton"
                        TabIndex="4"
                        ToolTip.Tip="More drawing tools"
                        AutomationProperties.Name="More drawing tools"
                        Classes="ToolbarIcon"
                        Padding="6,4">
                    <PathIcon Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z" Width="14" Height="14"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="TransientWithDismissOnPointerMoveAway">
                            <StackPanel Spacing="2" MinWidth="180">
                                <Button x:Name="DrawToolCircleFlyout"
                                        AutomationProperties.Name="Draw circle"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,6"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z" Width="14" Height="14"/>
                                        <TextBlock Text="Circle" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DrawToolFreehandFlyout"
                                        AutomationProperties.Name="Draw freehand"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,6"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="14" Height="14"/>
                                        <TextBlock Text="Freehand" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DrawToolLassoFlyout"
                                        AutomationProperties.Name="Lasso select"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,6"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M12 2C6.5 2 2 6.5 2 12c0 3.7 2 6.9 5 8.6l1-1.7C5.7 17.5 4 14.9 4 12c0-4.4 3.6-8 8-8s8 3.6 8 8c0 2.9-1.7 5.5-4 6.9l1 1.7c3-1.7 5-4.9 5-8.6 0-5.5-4.5-10-10-10z" Width="14" Height="14"/>
                                        <TextBlock Text="Lasso Select" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DrawToolPanFlyout"
                                        AutomationProperties.Name="Pan"
                                        Background="Transparent"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,6"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M10 2v8H2v4h8v8h4v-8h8v-4h-8V2h-4z" Width="14" Height="14"/>
                                        <TextBlock Text="Pan" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Hidden toggle buttons for advanced tools (state tracking by code-behind) -->
                <ToggleButton x:Name="DrawToolCircle"
                              IsVisible="False"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z" Width="14" Height="14"/>
                </ToggleButton>
                <ToggleButton x:Name="DrawToolFreehand"
                              IsVisible="False"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="14" Height="14"/>
                </ToggleButton>
                <ToggleButton x:Name="DrawToolLasso"
                              IsVisible="False"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M12 2C6.5 2 2 6.5 2 12c0 3.7 2 6.9 5 8.6l1-1.7C5.7 17.5 4 14.9 4 12c0-4.4 3.6-8 8-8s8 3.6 8 8c0 2.9-1.7 5.5-4 6.9l1 1.7c3-1.7 5-4.9 5-8.6 0-5.5-4.5-10-10-10z" Width="14" Height="14"/>
                </ToggleButton>
                <ToggleButton x:Name="DrawToolPan"
                              IsVisible="False"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M10 2v8H2v4h8v8h4v-8h8v-4h-8V2h-4z" Width="14" Height="14"/>
                </ToggleButton>

                <Separator Width="1" Height="20"
                           Background="{DynamicResource BorderSubtleBrush}"
                           Margin="4,0"/>

                <!-- Stroke Color -->
                <TextBlock Text="Stroke" VerticalAlignment="Center" FontSize="11" Margin="2,0"/>
                <Button x:Name="StrokeColorButton" TabIndex="8" Padding="2" VerticalAlignment="Center" ToolTip.Tip="Stroke color" AutomationProperties.Name="Stroke color">
                    <Border Width="20" Height="20" CornerRadius="2"
                            Background="{Binding DrawingStrokeColor}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"/>
                </Button>
                <Popup x:Name="StrokeColorPopup" PlacementTarget="{Binding #StrokeColorButton}" Placement="Bottom" IsLightDismissEnabled="True">
                    <Border Background="{DynamicResource AcrylicTintToolbarBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                        <WrapPanel Width="130">
                            <Button Classes="ColorSwatch" Tag="Transparent" Width="20" Height="20" Margin="2" Padding="0" ToolTip.Tip="None" AutomationProperties.Name="Stroke color none">
                                <Border Width="18" Height="18" CornerRadius="2" BorderBrush="#CCC" BorderThickness="1">
                                    <Line StartPoint="0,18" EndPoint="18,0" Stroke="Red" StrokeThickness="1.5"/>
                                </Border>
                            </Button>
                            <Button Classes="ColorSwatch" Tag="#000000" Background="#000000" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color black"/>
                            <Button Classes="ColorSwatch" Tag="#FFFFFF" Background="#FFFFFF" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color white"/>
                            <Button Classes="ColorSwatch" Tag="#808080" Background="#808080" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color gray"/>
                            <Button Classes="ColorSwatch" Tag="#FF0000" Background="#FF0000" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color red"/>
                            <Button Classes="ColorSwatch" Tag="#00FF00" Background="#00FF00" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color green"/>
                            <Button Classes="ColorSwatch" Tag="#0000FF" Background="#0000FF" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color blue"/>
                            <Button Classes="ColorSwatch" Tag="#FFFF00" Background="#FFFF00" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color yellow"/>
                            <Button Classes="ColorSwatch" Tag="#FF8000" Background="#FF8000" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color orange"/>
                            <Button Classes="ColorSwatch" Tag="#FF00FF" Background="#FF00FF" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color magenta"/>
                            <Button Classes="ColorSwatch" Tag="#00FFFF" Background="#00FFFF" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Stroke color cyan"/>
                        </WrapPanel>
                    </Border>
                </Popup>

                <!-- Fill Color -->
                <TextBlock Text="Fill" VerticalAlignment="Center" FontSize="11" Margin="2,0"/>
                <Button x:Name="FillColorButton" TabIndex="9" Padding="2" VerticalAlignment="Center" ToolTip.Tip="Fill color" AutomationProperties.Name="Fill color">
                    <Border Width="20" Height="20" CornerRadius="2"
                            Background="{Binding DrawingFillColor}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"/>
                </Button>
                <Popup x:Name="FillColorPopup" PlacementTarget="{Binding #FillColorButton}" Placement="Bottom" IsLightDismissEnabled="True">
                    <Border Background="{DynamicResource AcrylicTintToolbarBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                        <WrapPanel Width="130">
                            <Button Classes="FillColorSwatch" Tag="Transparent" Width="20" Height="20" Margin="2" Padding="0" ToolTip.Tip="None / Transparent" AutomationProperties.Name="Fill color transparent">
                                <Border Width="18" Height="18" CornerRadius="2" BorderBrush="#CCC" BorderThickness="1">
                                    <Line StartPoint="0,18" EndPoint="18,0" Stroke="Red" StrokeThickness="1.5"/>
                                </Border>
                            </Button>
                            <Button Classes="FillColorSwatch" Tag="#000000" Background="#000000" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color black"/>
                            <Button Classes="FillColorSwatch" Tag="#FFFFFF" Background="#FFFFFF" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color white"/>
                            <Button Classes="FillColorSwatch" Tag="#808080" Background="#808080" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color gray"/>
                            <Button Classes="FillColorSwatch" Tag="#FF0000" Background="#FF0000" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color red"/>
                            <Button Classes="FillColorSwatch" Tag="#00FF00" Background="#00FF00" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color green"/>
                            <Button Classes="FillColorSwatch" Tag="#0000FF" Background="#0000FF" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color blue"/>
                            <Button Classes="FillColorSwatch" Tag="#FFFF00" Background="#FFFF00" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color yellow"/>
                            <Button Classes="FillColorSwatch" Tag="#FF8000" Background="#FF8000" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color orange"/>
                            <Button Classes="FillColorSwatch" Tag="#FF00FF" Background="#FF00FF" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color magenta"/>
                            <Button Classes="FillColorSwatch" Tag="#00FFFF" Background="#00FFFF" Width="20" Height="20" Margin="2" Padding="0" AutomationProperties.Name="Fill color cyan"/>
                        </WrapPanel>
                    </Border>
                </Popup>

                <Separator Width="1" Height="20"
                           Background="{DynamicResource BorderSubtleBrush}"
                           Margin="4,0"/>

                <!-- Stroke Width -->
                <TextBlock Text="Width" VerticalAlignment="Center" FontSize="11" Margin="2,0"/>
                <ComboBox x:Name="StrokeWidthCombo" TabIndex="10" Width="60" VerticalAlignment="Center" FontSize="11" SelectedIndex="1" AutomationProperties.Name="Stroke width">
                    <ComboBoxItem Content="1 pt" Tag="1"/>
                    <ComboBoxItem Content="2 pt" Tag="2"/>
                    <ComboBoxItem Content="3 pt" Tag="3"/>
                    <ComboBoxItem Content="5 pt" Tag="5"/>
                    <ComboBoxItem Content="8 pt" Tag="8"/>
                </ComboBox>

                <Separator Width="1" Height="20"
                           Background="{DynamicResource BorderSubtleBrush}"
                           Margin="4,0"/>

                <!-- Selection containment mode toggle -->
                <ToggleButton x:Name="ContainmentModeToggle"
                              TabIndex="11"
                              ToolTip.Tip="Toggle: Intersect (partial) / Fully Contained selection"
                              AutomationProperties.Name="Toggle selection containment mode"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v8h-8V3zm2 2v4h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5z" Width="14" Height="14"/>
                </ToggleButton>

                <!-- Lock original objects toggle -->
                <ToggleButton x:Name="LockOriginalsToggle"
                              TabIndex="12"
                              ToolTip.Tip="Lock original PDF objects (prevent deletion)"
                              AutomationProperties.Name="Lock original PDF objects"
                              IsChecked="{Binding IsOriginalObjectsLocked}"
                              Classes="ToolbarIcon"
                              Padding="6,4">
                    <PathIcon Data="M12 1a5 5 0 0 0-5 5v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5zm3 7H9V6a3 3 0 1 1 6 0v2z" Width="14" Height="14"/>
                </ToggleButton>

                <!-- Close button -->
                <Button x:Name="DrawingToolbarCloseButton"
                        TabIndex="13"
                        Content="&#xD7;"
                        Classes="Ghost"
                        ToolTip.Tip="Close drawing toolbar (Esc)"
                        AutomationProperties.Name="Close drawing toolbar"
                        Command="{Binding CloseDrawingToolbarCommand}"
                        Padding="6,4"
                        FontSize="14"
                        FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area with Sidebars -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">

            <!-- Thumbnails Sidebar -->
            <controls:ThumbnailsSidebar Grid.Column="0"
                                        DataContext="{Binding Thumbnails}"
                                        IsVisible="{Binding $parent[UserControl].DataContext.IsSidebarVisible}"
                                        Width="180"
                                        KeyboardNavigation.TabNavigation="Continue"/>

            <!-- PDF Content Area -->
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="PdfScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource BackgroundBaseBrush}">

                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Margin="16"
                            Background="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">

                        <!-- PDF Page with Selection and Drawing Overlays -->
                        <Grid>
                            <!-- PDF Page Image -->
                            <Image Source="{Binding CurrentPageImage}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   x:Name="PdfImage"/>

                            <!-- Selection Rectangle Overlay -->
                            <Canvas x:Name="SelectionCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False">
                                <Rectangle x:Name="SelectionRectangle"
                                           Fill="#4000BFFF"
                                           Stroke="#FF00BFFF"
                                           StrokeThickness="1"
                                           IsVisible="False"/>
                            </Canvas>

                            <!-- Select All Text Highlight Overlay -->
                            <Rectangle Fill="#200078D4"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding HasSelectedText}"/>

                            <!-- Search Highlight Overlay -->
                            <controls:SearchHighlightOverlay
                                IsHitTestVisible="False"
                                SearchMatches="{Binding Search.SearchMatches}"
                                CurrentMatchIndex="{Binding Search.CurrentMatchIndex}"
                                CurrentPageIndex="{Binding CurrentPageIndex}"
                                ZoomLevel="{Binding ZoomLevel}"
                                PageWidth="{Binding CurrentPageWidth}"
                                PageHeight="{Binding CurrentPageHeight}"/>

                            <!-- Drawing Canvas Overlay -->
                            <Canvas x:Name="DrawingCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="{Binding IsDrawingToolActive}"
                                    Background="Transparent"/>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- Loading Overlay with Skeleton Shimmer -->
                <Border Background="{DynamicResource DialogOverlayBrush}"
                        IsVisible="{Binding IsLoading}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <!-- Page-shaped skeleton placeholder -->
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Width="280"
                                Height="360"
                                ClipToBounds="True">
                            <controls:ShimmerPlaceholder CornerRadius="4"/>
                        </Border>

                        <!-- Status message below skeleton -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource ForegroundInverseBrush}"
                                   HorizontalAlignment="Center"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Error Display - hidden, errors shown via dialog service -->
                <Border Background="{DynamicResource BackgroundBaseBrush}"
                        IsVisible="False">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16"
                                MaxWidth="400">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Width="48"
                                  Height="48"
                                  Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                        <TextBlock Text="An error occurred"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <Button Content="Try Again"
                                Command="{Binding OpenDocumentCommand}"
                                Classes="Secondary"
                                AutomationProperties.Name="Try again"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right Sidebar (Bookmarks + Annotations + Metadata) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        KeyboardNavigation.TabNavigation="Continue">
                <controls:BookmarksPanel DataContext="{Binding Bookmarks}"
                                         IsVisible="{Binding $parent[UserControl].DataContext.IsBookmarksPanelVisible}"
                                         Width="250"
                                         KeyboardNavigation.TabNavigation="Continue"/>
                <controls:AnnotationsPanel DataContext="{Binding AnnotationsList}"
                                            IsVisible="{Binding $parent[UserControl].DataContext.IsAnnotationsPanelVisible}"
                                            Width="280"
                                            KeyboardNavigation.TabNavigation="Continue"/>
                <controls:MetadataPanel DataContext="{Binding Metadata}"
                                        IsVisible="{Binding $parent[UserControl].DataContext.IsMetadataPanelVisible}"
                                        Width="280"
                                        KeyboardNavigation.TabNavigation="Continue"/>
            </StackPanel>
        </Grid>
        <!-- Page Summary Strip -->
        <Border Grid.Row="3"
                Background="{DynamicResource AcrylicTintToolbarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4"
                IsVisible="{Binding PageSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding PageSummary}"
                       FontSize="12"
                       Opacity="0.8"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Page summary" />
        </Border>

        <!-- Selection Status Bar -->
        <Border Grid.Row="4"
                Background="{DynamicResource AcrylicTintToolbarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                IsVisible="{Binding HasSelectedText}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedText}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="Ctrl+C to copy"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundTertiaryBrush}"/>
            </Grid>
        </Border>
        <!-- Long Operation Progress Overlay (merge, export, watermark) -->
        <controls:ProgressOverlay Grid.Row="0"
                                  Grid.RowSpan="5"
                                  IsVisible="{Binding IsOperationInProgress}"
                                  OperationDescription="{Binding OperationDescription}"
                                  Progress="{Binding OperationProgress}"
                                  CancelCommand="{Binding CancelLongOperationCommand}"/>
    </Grid>
</UserControl>
