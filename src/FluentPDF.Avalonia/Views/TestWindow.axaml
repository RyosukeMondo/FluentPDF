<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FluentPDF.Avalonia.Views.TestWindow"
        Title="TEST - FluentPDF Avalonia"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <TextBlock Text="✅ AVALONIA IS WORKING!"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#008000"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="If you can see this window, Avalonia rendering works!"
                       FontSize="16"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Window should be visible and centered on screen"
                       FontSize="14"
                       Foreground="#666666"
                       HorizontalAlignment="Center"/>

            <Button Content="Close Test Window"
                    HorizontalAlignment="Center"
                    Padding="20,10"
                    FontSize="16"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>

</Window>
