<Project>
  <!-- Completely disable the real XAML compiler -->
  <PropertyGroup>
    <DisableXbfGeneration>true</DisableXbfGeneration>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
  </PropertyGroup>

  <!-- Completely replace MarkupCompilePass1 with our stub generator -->
  <Target Name="MarkupCompilePass1">
    <Message Text="Skipping broken XAML compiler - using pre-generated stubs" Importance="high" />

    <!-- Run our stub generator -->
    <Exec Command="pwsh -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../../tools/generate-xaml-stubs.ps1&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)../../"
          IgnoreExitCode="false" />

    <Message Text="✓ Generated XAML stubs successfully" Importance="high" />

    <!-- Copy XAML files to obj directory so MSBuild can find them -->
    <ItemGroup>
      <XamlFilesToCopy Include="@(Page)" />
      <XamlFilesToCopy Include="@(ApplicationDefinition)" />
    </ItemGroup>

    <Copy SourceFiles="@(XamlFilesToCopy)"
          DestinationFiles="@(XamlFilesToCopy->'$(IntermediateOutputPath)%(RelativeDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <!-- Include generated .g.cs files in compilation -->
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)**\*.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Override Pass2 and error handler to do nothing -->
  <Target Name="MarkupCompilePass2" />
  <Target Name="_OnXamlPreCompileError" />
</Project>
