<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="FluentPDF.App.Controls.TwoPageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid AutomationProperties.AutomationId="TwoPageViewerRoot">
        <ScrollViewer
            x:Name="TwoPageScrollViewer"
            AutomationProperties.AutomationId="TwoPageScrollViewer"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            HorizontalAlignment="Center">

            <Grid HorizontalAlignment="Center" Margin="20">
                <Grid.ColumnDefinitions>
                    <!-- Left page (even pages) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center spacing -->
                    <ColumnDefinition Width="24" />
                    <!-- Right page (odd pages) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Page (Even) -->
                <Border
                    Grid.Column="0"
                    x:Name="LeftPageBorder"
                    AutomationProperties.AutomationId="LeftPageBorder"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Shadow="{StaticResource SharedShadow}"
                    Visibility="Collapsed">
                    <Grid>
                        <Image
                            x:Name="LeftPageImage"
                            AutomationProperties.AutomationId="LeftPageImage"
                            Stretch="None"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <!-- Page number badge -->
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="12"
                            Padding="12,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8">
                            <TextBlock
                                x:Name="LeftPageNumber"
                                AutomationProperties.AutomationId="LeftPageNumber"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </Border>

                        <!-- Loading indicator -->
                        <ProgressRing
                            x:Name="LeftPageLoader"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Center Divider -->
                <Border
                    Grid.Column="1"
                    Width="2"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    VerticalAlignment="Stretch"
                    Margin="0,20" />

                <!-- Right Page (Odd) -->
                <Border
                    Grid.Column="2"
                    x:Name="RightPageBorder"
                    AutomationProperties.AutomationId="RightPageBorder"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Shadow="{StaticResource SharedShadow}">
                    <Grid>
                        <Image
                            x:Name="RightPageImage"
                            AutomationProperties.AutomationId="RightPageImage"
                            Stretch="None"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <!-- Page number badge -->
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="12"
                            Padding="12,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8">
                            <TextBlock
                                x:Name="RightPageNumber"
                                AutomationProperties.AutomationId="RightPageNumber"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </Border>

                        <!-- Loading indicator -->
                        <ProgressRing
                            x:Name="RightPageLoader"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Page navigation indicator -->
        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24"
            Shadow="{StaticResource SharedShadow}">
            <TextBlock
                x:Name="PageRangeIndicator"
                AutomationProperties.AutomationId="PageRangeIndicator"
                FontSize="14"
                FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
